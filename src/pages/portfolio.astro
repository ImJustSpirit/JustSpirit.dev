                </div>
                <div slot="expand">
                    
                </div>
            </PortfolioLayout>
            <PortfolioLayout project="My Day Out :)" date="26/10/'25" image="MyDayOut.png" alt="">
                <p class="desc"></p>
                <div class="skills">
					Team Lead<br>
					Unity '22<br>
					C#<br>
                </div>
                <div slot="expand">
                    
                </div>
            </PortfolioLayout>
            <PortfolioLayout project="Ouroboros Engine" date="03/08/'25" image="OuroborosEngine.png" alt="">
                <p class="desc"></p>
                <div class="skills">
					Team Lead<br>
					Unity '22<br>
