---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Navigation from '../components/Navigation.astro';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import Skills from '../components/Skills.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>JustSpirit.dev</title>
		<link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
	</head>
	<body>
		<Header />
		<div class="page">
            <Navigation />
			<div class="content">
				<h1>Portfolio</h1>
                <p>Hello, I'm Jack, a games programmer from the North-East of England.</p>
			</div>
            <PortfolioLayout project="Inventory System" date=">.Present" image="" alt="">
                <p class="desc"></p>
                <div class="skills">
					UE 5.7.4<br>
					C++<br>
					Plugin Dev<br>
                </div>
            </PortfolioLayout>
            <PortfolioLayout project="JustSpirit.dev" date="02/10/'26" image="" alt="">
                <p class="desc">The very website you are reading this on. Planned to include all sorts such as: a gallery; fiction writing; blog posts; and a forum...?</p>
                <div class="skills">
					Astro<br>
					HTML<br>
					CSS<br>
                </div>
            </PortfolioLayout>
            <PortfolioLayout project="Skill Creation System" date="06/01/'26" image="" alt="">
                <p class="desc"></p>
                <div class="skills">
					Unity '22<br>
					C#<br>
					Plugin Dev<br>
                </div>
            </PortfolioLayout>
            <PortfolioLayout project="My Day Out :)" date="26/10/'25" image="" alt="">
                <p class="desc"></p>
                <div class="skills">
					Team Lead<br>
					Unity '22<br>
					C#<br>
                </div>
            </PortfolioLayout>
            <PortfolioLayout project="Ouroboros Engine" date="03/08/'25" image="" alt="">
                <p class="desc"></p>
                <div class="skills">
					Team Lead<br>
					Unity '22<br>
					C#<br>
                </div>
            </PortfolioLayout>
            <PortfolioLayout project="Dungeon Merchant" date="11/12/'23" image="" alt="">
                <p class="desc"></p>
                <div class="skills">
					Game Design<br>
					Level Design<br>
					World Design<br>
                </div>
            </PortfolioLayout>
		</div>
		<Footer />
	</body>
</html>
